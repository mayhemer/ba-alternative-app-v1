<?xml version="1.0" encoding="utf-8"?>
<!-- 1 px between the live and the next row, equal space above and below.
     The line is a FrameLayout: a notification can't draw a plain View, and
     Android then removes the whole card (androidLayouts.test.ts). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:paddingTop="@dimen/nc_divider_gap"
  android:paddingBottom="@dimen/nc_divider_gap">
  <FrameLayout
    android:layout_width="match_parent"
    android:layout_height="1px"
    android:background="@color/nc_divider" />
</FrameLayout>
