<?xml version="1.0" encoding="utf-8"?>
<!-- The expanded card's clash row, as iOS's layout #4:
     THE NEXT CLASHING BAND ……………………… [+N]
     −28:00 ⚠ ……………… 19:40–20:30 · Stage -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical">
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">
    <TextView
      android:includeFontPadding="false"
      android:id="@+id/nc_name"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="@color/nc_text"
      android:textSize="@dimen/nc_clash_name"
      android:textStyle="bold" />
    <TextView
      android:includeFontPadding="false"
      android:id="@+id/nc_more"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="6dp"
      android:fontFeatureSettings="tnum"
      android:textColor="@color/nc_danger"
      android:textSize="@dimen/nc_clash_name"
      android:textStyle="bold"
      android:visibility="gone" />
  </LinearLayout>
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/nc_line_gap"
    android:gravity="center_vertical"
    android:orientation="horizontal">
    <Chronometer
      android:includeFontPadding="false"
      android:id="@+id/nc_countdown"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:fontFeatureSettings="tnum"
      android:textColor="@color/nc_danger"
      android:textSize="@dimen/nc_meta"
      android:textStyle="bold" />
    <ImageView
      android:layout_width="14dp"
      android:layout_height="14dp"
      android:layout_marginStart="5dp"
      android:contentDescription="@string/nc_clash"
      android:src="@drawable/nc_warn" />
    <include layout="@layout/nc_time_stage" />
  </LinearLayout>
</LinearLayout>
