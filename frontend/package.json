{
  "name": "frontend",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "tscheck": "npx tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "test": "jest",
    "test:watch": "jest --watch",
    "gen:fixtures": "node --experimental-strip-types --no-warnings scripts/gen-fixtures.ts",
    "test:perf": "TEST_RUNNER_ARGS=\"--config jest.perf.config.ts --runInBand\" reassure",
    "test:perf:baseline": "TEST_RUNNER_ARGS=\"--config jest.perf.config.ts --runInBand\" reassure --baseline",
    "test:perf:gate": "node --experimental-strip-types --no-warnings scripts/check-render-counts.ts",
    "test:e2e:web": "playwright test",
    "test:e2e:ios": "node --experimental-strip-types --no-warnings scripts/test-e2e-ios.ts",
    "clean:e2e:ios": "node --experimental-strip-types --no-warnings scripts/clean-e2e-ios.ts",
    "test:perf:device": "node --experimental-strip-types --no-warnings scripts/test-perf-device.ts",
    "test:perf:device:baseline": "node --experimental-strip-types --no-warnings scripts/test-perf-device.ts --baseline",
    "install:perf:android": "node --experimental-strip-types --no-warnings scripts/install-perf-android.ts",
    "serve:fixtures": "node --experimental-strip-types --no-warnings tests/server/fixtureServer.ts 4010",
    "verify": "scripts/test-all",
    "verify:fast": "scripts/test-all --fast",
    "doctor": "npx expo-doctor",
    "gen:icons": "node scripts/gen-icons.js",
    "start:sim:ios": "npx expo run:ios",
    "start:device:ios": "npx expo run:ios --device",
    "start:web": "npx expo start --web",
    "prebuild:ios": "npx expo prebuild --platform ios --clean",
    "build:preview:ios": "eas build --platform ios --profile preview",
    "build:preview:android": "eas build --platform android --profile preview",
    "build:perf:android": "eas build --platform android --profile perf",
    "build:e2e:ios": "eas build --platform ios --profile e2e-ios-sim",
    "build:web": "npx expo export --platform web"
  },
  "dependencies": {
    "@babel/core": "^7.26.0",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.2.8",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/drawer": "^7.9.8",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.10",
    "babel-preset-expo": "~55.0.8",
    "expo": "~55.0.31",
    "expo-apple-authentication": "~55.0.17",
    "expo-asset": "~55.0.20",
    "expo-auth-session": "~55.0.18",
    "expo-crypto": "~55.0.19",
    "expo-dev-client": "~55.0.40",
    "expo-font": "~55.0.8",
    "expo-image": "~55.0.11",
    "expo-linear-gradient": "~55.0.18",
    "expo-secure-store": "~55.0.18",
    "expo-splash-screen": "~55.0.25",
    "expo-status-bar": "~55.0.6",
    "expo-system-ui": "~55.0.22",
    "expo-web-browser": "~55.0.20",
    "nativewind": "^4.2.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-render-html": "^6.3.4",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.7.4",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.10",
    "eslint": "^8.57.1",
    "eslint-config-react-app": "^7.0.1",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.22",
    "msw": "^2.15.0",
    "reassure": "^1.6.0",
    "test-renderer": "^1.3.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2"
  },
  "private": true
}
