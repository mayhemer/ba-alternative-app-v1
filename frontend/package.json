{
  "name": "frontend",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "test": "scripts/test-smoke",
    "verify": "scripts/test-verify",
    "commit-check": "scripts/test-commit",
    "test:types": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "test:lint": "eslint src",
    "test:unit": "jest",
    "test:unit:watch": "jest --watch",
    "test:doctor": "npm_config_loglevel=notice expo-doctor",
    "test:perf": "scripts/test/perf",
    "test:perf:measure": "TEST_RUNNER_ARGS=\"--config jest.perf.config.ts --runInBand\" reassure",
    "test:perf:baseline": "TEST_RUNNER_ARGS=\"--config jest.perf.config.ts --runInBand\" reassure --baseline && npm run --silent test:perf:issues -- --record",
    "test:perf:gate": "node --experimental-strip-types --no-warnings scripts/test/perf-gate.ts",
    "test:perf:issues": "node --experimental-strip-types --no-warnings scripts/test/perf-issues.ts",
    "test:e2e:web": "npm run --silent build:web && playwright test",
    "test:e2e:ios": "node --experimental-strip-types --no-warnings scripts/test/e2e-ios.ts",
    "test:e2e:ios:eas": "node --experimental-strip-types --no-warnings scripts/test/e2e-ios.ts --eas",
    "test:perf:device": "node --experimental-strip-types --no-warnings scripts/test/perf-device.ts",
    "test:perf:device:baseline": "node --experimental-strip-types --no-warnings scripts/test/perf-device.ts --baseline",
    "gen:fixtures": "node --experimental-strip-types --no-warnings scripts/gen-fixtures.ts",
    "clean:e2e:ios": "node --experimental-strip-types --no-warnings scripts/clean-e2e-ios.ts",
    "install:perf:android": "node --experimental-strip-types --no-warnings scripts/install-android.ts --profile perf",
    "install:preview:android": "node --experimental-strip-types --no-warnings scripts/install-android.ts --profile preview",
    "serve:fixtures": "node --experimental-strip-types --no-warnings tests/server/fixtureServer.ts 4010",
    "gen:icons": "node scripts/gen-icons.js",
    "start:sim:ios": "npx expo run:ios",
    "start:device:ios": "npx expo run:ios --device",
    "start:web": "npx expo start --web",
    "prebuild:ios": "npx expo prebuild --platform ios --clean",
    "build:preview:ios": "eas build --platform ios --profile preview",
    "build:preview:android": "eas build --platform android --profile preview --non-interactive",
    "build:perf:android": "eas build --platform android --profile perf --non-interactive",
    "build:e2e:ios": "eas build --platform ios --profile e2e-ios-sim",
    "build:web": "npx expo export --platform web"
  },
  "dependencies": {
    "@babel/core": "^7.26.0",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native/jest-preset": "0.88.0",
    "@react-navigation/drawer": "^7.9.8",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.10",
    "babel-preset-expo": "~58.0.0",
    "expo": "~58.0.20",
    "expo-apple-authentication": "~58.0.2",
    "expo-asset": "~58.0.18",
    "expo-auth-session": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.16",
    "expo-font": "~58.0.10",
    "expo-image": "~58.0.17",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.7",
    "nativewind": "^4.2.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-render-html": "^6.3.4",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^8.57.1",
    "eslint-config-react-app": "^7.0.1",
    "expo-doctor": "1.21.5",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "msw": "^2.15.0",
    "reassure": "^1.6.0",
    "test-renderer": "^1.3.0",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-render-html"
        ]
      }
    }
  }
}
