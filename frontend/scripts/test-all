#!/usr/bin/env bash
# ── One command to check everything that runs without a device ────────────────
#
# Fail-fast and in cheapest-first order, so a typo is reported in seconds rather
# than after the browser suite. The suites that test a built binary — the iOS
# simulator E2E and the physical Android phone — are printed as a follow-up:
# they run a build, not this working tree (the iOS :local variant makes that
# build here first, which takes minutes).
#
#   npm run verify
#   npm run verify -- --fast    skip the slow step: performance regressions

set -euo pipefail
cd "$(dirname "$0")/.."

FAST=0
for arg in "$@"; do
  case "$arg" in
    --fast) FAST=1 ;;
    *) echo "unknown option: $arg (only --fast)" >&2; exit 2 ;;
  esac
done

step() { printf '\n\033[1m── %s ───────────────────────────────────────\033[0m\n' "$1"; }
skipped() { printf '\n\033[2m── %s: skipped (--fast)\033[0m\n' "$1"; }

step "Types"
npm run --silent tscheck

step "Lint"
npx eslint src

step "Unit + integration (ios, android, web)"
npx jest

if [ "$FAST" -eq 1 ]; then
  skipped "Performance regressions"
else
  step "Performance regressions"
  # Compares against .reassure/baseline.perf. The baseline is machine-specific,
  # so re-record it locally with `npm run test:perf:baseline` before trusting a
  # duration change; render counts are comparable anywhere.
  if [ -f .reassure/baseline.perf ]; then
    npm run --silent test:perf
    # Reassure itself never fails on a regression; this fails on the
    # deterministic part of it — render counts. Durations stay advisory.
    npm run --silent test:perf:gate
  else
    echo "no baseline yet — run 'npm run test:perf:baseline' first"
  fi
fi

step "Web end-to-end"
# Needs the exported build the tests actually run against.
npm run --silent build:web
npx playwright test

if [ "$FAST" -eq 1 ]; then
  printf '\n\033[32m✓ fast check green\033[0m — performance was not run\n'
else
  printf '\n\033[32m✓ everything that tests this working tree is green\033[0m\n'
fi
cat <<'NEXT'

Not covered above — these test a built binary, so rebuild after app changes
(test:e2e:ios:local builds one itself):

  npm run test:e2e:ios:local       iOS simulator E2E, built here from this tree
  npm run build:e2e:ios            or via EAS, then npm run test:e2e:ios
  npm run build:perf:android       then, with the phone connected over USB:
  npm run install:perf:android     latest `perf` build onto the phone
  npm run test:perf:device         frame, start-up and memory measurements

NEXT
