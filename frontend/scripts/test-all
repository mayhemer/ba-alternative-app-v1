#!/usr/bin/env bash
# ── One command to check everything that runs on this Mac ─────────────────────
#
# Fail-fast and in cheapest-first order, so a typo is reported in seconds rather
# than after the browser suite. Last comes the iOS simulator E2E, on a Release
# build of this working tree made here first (minutes). The physical Android
# phone suite tests an EAS build, not this tree, so it is printed as a follow-up.
#
#   npm run verify
#   npm run verify -- --fast    skip the slow steps: performance regressions and
#                               the iOS simulator E2E

set -euo pipefail
cd "$(dirname "$0")/.."

FAST=0
for arg in "$@"; do
  case "$arg" in
    --fast) FAST=1 ;;
    *) echo "unknown option: $arg (only --fast)" >&2; exit 2 ;;
  esac
done

step() { printf '\n\033[1m── %s ───────────────────────────────────────\033[0m\n' "$1"; }
skipped() { printf '\n\033[2m── %s: skipped (--fast)\033[0m\n' "$1"; }

step "Types"
npm run --silent tscheck

step "Lint"
npx eslint src

step "Unit + integration (ios, android, web)"
npx jest

if [ "$FAST" -eq 1 ]; then
  skipped "Performance regressions"
else
  step "Performance regressions"
  # Compares against .reassure/baseline.perf. The baseline is machine-specific,
  # so re-record it locally with `npm run test:perf:baseline` before trusting a
  # duration change; render counts are comparable anywhere.
  if [ -f .reassure/baseline.perf ]; then
    npm run --silent test:perf
    # Reassure itself never fails on a regression; this fails on the
    # deterministic part of it — render counts. Durations stay advisory.
    npm run --silent test:perf:gate
  else
    echo "no baseline yet — run 'npm run test:perf:baseline' first"
  fi
fi

step "Web end-to-end"
# Needs the exported build the tests actually run against.
npm run --silent build:web
npx playwright test

if [ "$FAST" -eq 1 ]; then
  skipped "iOS simulator end-to-end"
else
  step "iOS simulator end-to-end"
  # A suite that could not run is a failure, not a pass: an unnoticed skip
  # would leave iOS untested. Exit 4 is the runner's "a prerequisite is
  # missing" (Xcode, Maestro, the simulator, a prebuilt ios/); it has just
  # printed which one and the command that fixes it.
  ios_status=0
  npm run --silent test:e2e:ios:local || ios_status=$?
  if [ "$ios_status" -eq 4 ]; then
    printf '\n\033[31m✗ verify failed: the iOS simulator E2E could not run.\033[0m\n'
    printf '  The reason and the fix are printed just above (SKIPPED — …). Fix it and re-run;\n'
    printf '  the iOS suite is required, a skip does not count as a pass.\n'
    exit 1
  elif [ "$ios_status" -ne 0 ]; then
    exit "$ios_status"
  fi
fi

if [ "$FAST" -eq 1 ]; then
  printf '\n\033[32m✓ fast check green\033[0m — performance and iOS E2E were not run\n'
else
  printf '\n\033[32m✓ everything that tests this working tree is green\033[0m\n'
fi
cat <<'NEXT'

Not covered above — these test an EAS build, so rebuild after app changes:

  npm run build:perf:android       then, with the phone connected over USB:
  npm run install:perf:android     latest `perf` build onto the phone
  npm run test:perf:device         frame, start-up and memory measurements

NEXT
