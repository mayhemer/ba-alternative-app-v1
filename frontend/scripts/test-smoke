#!/usr/bin/env bash
# ── The smoke batch: everything quick, no device ──────────────────────────────
#
#   npm test                    about 1 min
#
# The commit batch plus the web E2E in a real browser. `npm run verify` adds the
# expo-doctor checks, performance regressions and the iOS simulator E2E.

source "$(dirname "$0")/lib/batch.sh"

unit "Types" test:types
unit "Lint" test:lint
unit "Unit + integration" test:unit
unit "Web end-to-end" test:e2e:web

passed "smoke green — doctor, performance and iOS E2E were not run"
