#!/usr/bin/env bash
# ── Performance regressions, as one test unit ─────────────────────────────────
#
#   npm run test:perf
#
# Measures this tree with Reassure against the committed .reassure/baseline.perf,
# then fails on any render count that went up (perf-gate.ts) — Reassure itself
# only reports. Durations stay advisory: the baseline is machine-specific, so
# re-record it locally with `npm run test:perf:baseline` before trusting a
# duration change; render counts are comparable anywhere.
#
# Last, warns on any render issue (initial or redundant updates) that differs
# from the committed .reassure/render-issues.json, better or worse
# (perf-issues.ts). That check never fails the unit, so it runs after the gate
# whatever the gate decided.

set -euo pipefail
cd "$(dirname "$0")/../.."

if [ ! -f .reassure/baseline.perf ]; then
  echo "no performance baseline at .reassure/baseline.perf — record one with 'npm run test:perf:baseline'" >&2
  exit 1
fi

npm run --silent test:perf:measure
status=0
npm run --silent test:perf:gate || status=$?
npm run --silent test:perf:issues
exit "$status"
